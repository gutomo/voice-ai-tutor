# コピーして .env を作り、実値を入れること。.env はコミット禁止 (.gitignore 済み)。
# Phase 0 ではどれも未設定でアプリは起動する。各 Phase で必要になったら埋める。

# --- Azure AI Speech (STT / 発音評価 / TTS, ja-JP) ---
# Phase 2 の発音採点に必須。未設定だと /api/turn/{id}/score は 503 を返す (アプリ自体は起動する)。
# 開発は F0 (無料枠) を japaneast で作れば課金ゼロ。
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast

# --- AWS (Bedrock Claude + SES) ---
# Phase 3 の会話生成・ルーブリック採点に必須。未設定だと /api/conversation/reply と
# /api/turn/{id}/evaluate (roleplay) は 503 を返す (アプリ自体は起動する)。
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bedrock のモデル/推論プロファイルID (Bedrock コンソールで確認。例: us.anthropic.claude-sonnet 系)
BEDROCK_MODEL_ID=

# --- データベース (ローカルは docker compose の Postgres) ---
DATABASE_URL=postgresql://tutor:tutor@localhost:5432/tutor

# --- メール (SES で検証済みの送信元アドレス) ---
EMAIL_SENDER=
