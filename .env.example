# コピーして .env を作り、実値を入れること。.env はコミット禁止 (.gitignore 済み)。
# Phase 0 ではどれも未設定でアプリは起動する。各 Phase で必要になったら埋める。

# --- Azure AI Speech (STT / 発音評価 / TTS, ja-JP) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast

# --- AWS (Bedrock Claude + SES) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bedrock のモデル/推論プロファイルID (Bedrock コンソールで確認)
BEDROCK_MODEL_ID=

# --- データベース (ローカルは docker compose の Postgres) ---
DATABASE_URL=postgresql://tutor:tutor@localhost:5432/tutor

# --- メール (SES で検証済みの送信元アドレス) ---
EMAIL_SENDER=
